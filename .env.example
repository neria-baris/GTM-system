# Required for live mode only. Supply your own credentials; keep .env private.
NOTION_API_KEY=
AIRTABLE_TOKEN=
OPENAI_API_KEY=
JEV_API_KEY=

# Optional discovery scope hints (empty means discovery of accessible sources).
NOTION_ROOT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
# Notion workspace export zip (Markdown & CSV) to use instead of the Notion API.
NOTION_EXPORT_ZIP=
# CRM export JSON (airtable-base-export/1) to use instead of the Airtable API.
# The bundled sample: NOTION_EXPORT_ZIP=config/notion_export.zip, CRM_EXPORT_JSON=config/crm_export.json
CRM_EXPORT_JSON=
AIRTABLE_BASE_ID=

# Optional overrides. Empty uses the packaged defaults documented in INSTALL.md.
OPENAI_SEMANTIC_MODEL=
OPENAI_SEMANTIC_REASONING=
OPENAI_SEMANTIC_MAX_CONCURRENCY=
OPENAI_EXTRACTION_MODEL=
JEV_REPEATS=
JEV_MAX_CONCURRENCY=
